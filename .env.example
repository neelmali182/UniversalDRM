# UniversalDRM — Environment Configuration (§22.3)
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Application
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://udrm:udrm@localhost:5432/universaldrm

# Redis
REDIS_URL=redis://localhost:6379/0

# Object Storage
STORAGE_PROVIDER=local          # local | minio | s3 | r2
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=universaldrm
STORAGE_LOCAL_DIR=~/.universaldrm/objects

# AWS S3 / MinIO credentials (only for minio/s3 providers)
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin

# Key Management
KMS_PROVIDER=local              # local | aws_kms | vault | hsm
# AWS_KMS_KEY_ID=arn:aws:kms:...
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=dev-token

# Security
SECRET_KEY=change-me-in-production-use-a-32-char-random-string
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# TTLs (seconds)
SESSION_TTL=600
RESOURCE_TOKEN_TTL=60
SHARE_TTL=3600
OTP_TTL=600

# Limits
MAX_UPLOAD_MB=500

# Email (OTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@universaldrm.local
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=false

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
